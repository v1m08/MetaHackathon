# Meta Model API (OpenAI-compatible). Leave MODEL_API_KEY empty to run in mock mode.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model IDs. Check GET /v1/models (the AI Inspector has a "List models" button) and set these.
MODEL_TEXT=muse-spark
MODEL_IMAGE=muse-image

# auto = live when MODEL_API_KEY is set, otherwise mock. Force with "live" or "mock".
AI_MODE=auto
