# Meta Model API (OpenAI-compatible). Get a key from the hackathon; leave empty for mock mode.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Model ids confirmed with GET /v1/models and real requests on 2026-11-12 (see PLAN.md):
MODEL_TEXT=muse-spark-1.3        # the agent: tool calling, planning, writing
MODEL_VISION=muse-ember-1.0      # image understanding (photo/Reel notes); fast and cheap
MODEL_FAST=muse-ember-1.0        # bulk/cheap work: persona simulations, batch indexing
MODEL_IMAGE=muse-image-1.0       # image generation (not used by the travel feature)

AI_MODE=auto                     # auto | live | mock   (auto = live when a key is set)

# Budget guard (enforced in code by src/lib/ai/ledger.ts; ledger is the gitignored .ai-ledger.json)
MODEL_BUDGET_USD=50              # hard ceiling for this key in this repo
MODEL_BUDGET_RESERVE_USD=10      # kept for final QA / recordings; only AI_FINAL=1 processes may spend it
# AI_FINAL=1
