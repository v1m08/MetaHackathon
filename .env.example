# Copy to .env.local (never committed). Leave the key empty to run in mock / cached mode.

# Meta Model API (OpenAI-compatible). META_MODEL_* and MODEL_* are interchangeable.
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1

# Hang Again model routing. Check the Meta Model API docs (or GET /v1/models; the AI Inspector at
# /dev/ai has a "List models" button) for the exact IDs your key can use. These were live on 2026-11-12.
MUSE_EMBER_MODEL=muse-ember-1.0
MUSE_WONDER_MODEL=muse-wonder-1.0

# Base app models (composer, group digest, listings).
MODEL_TEXT=muse-spark-1.3
MODEL_IMAGE=muse-image-1.0

# auto = live when a key is set, otherwise mock. Force with "live" or "mock".
AI_MODE=auto

# Hang Again demo "today" (YYYY-MM-DD). Can also be changed at runtime from /demo.
DEMO_DATE=2026-11-14
# Hang Again AI mode at boot: live | cached. Defaults to live when a key is set, cached otherwise.
HANGOUT_AI_MODE=
