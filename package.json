{
  "name": "fb-young-adults-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "warm": "curl -s http://localhost:3000/api/admin/warm-images",
    "reset": "curl -s -X POST http://localhost:3000/api/admin/reset",
    "test": "tsx --test 'src/**/*.test.ts'",
    "eval:moments": "tsx scripts/eval-moments.ts",
    "memory:rebuild": "tsx scripts/rebuild-memory.ts",
    "hangout:reset": "curl -s -X POST http://localhost:3000/api/hangout/demo -H 'content-type: application/json' -d '{\"action\":\"reset\"}'",
    "seed:images": "tsx scripts/seed-images.ts",
    "critters:generate": "tsx scripts/generate-critters.ts",
    "critters:cutout": "tsx scripts/cutout-critters.ts",
    "critters:moods": "tsx scripts/critter-moods.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.4",
    "swr": "^2.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0"
  }
