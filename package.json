{
  "name": "fb-young-adults-base",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "warm": "curl -s http://localhost:3000/api/admin/warm-images",
    "reset": "curl -s -X POST http://localhost:3000/api/admin/reset",
    "test": "node --import tsx --test \"tests/**/*.test.mjs\" \"tests/**/*.test.ts\"",
    "ledger": "node scripts/ledger.mjs",
    "index-media": "curl -s -X POST \"http://localhost:3000/api/admin/index-media\"",
    "media-pick": "node scripts/media-pick.mjs",
    "record": "node scripts/record.mjs",
    "replay:on": "curl -s -X POST localhost:3000/api/admin/mode -H 'content-type: application/json' -d '{\"replay\":true}'",
    "replay:off": "curl -s -X POST localhost:3000/api/admin/mode -H 'content-type: application/json' -d '{\"replay\":false}'",
    "eval": "node scripts/eval.mjs",
    "credits": "node scripts/credits.mjs",
    "sim": "node scripts/sim.mjs",
    "animations": "node scripts/build-animations.mjs",
    "eval:opendoor": "node scripts/eval-opendoor.mjs",
    "eval:reconnect": "node scripts/eval-reconnect.mjs",
    "qa:reconnect": "node scripts/qa-reconnect.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
